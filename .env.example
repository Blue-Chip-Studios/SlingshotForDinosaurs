# Copy this file to .env and fill in the values. .env is gitignored.

# Roblox Open Cloud API key. Create it at create.roblox.com > (your profile) > All tools > API Keys > Create API Key.
# Permissions: asset-permissions, asset, developer-products, game-passes, universe-analytics, universe, universe-places.
# Restrict it to your IP address or to this game's place/universe.
ROBLOX_API_KEY=
